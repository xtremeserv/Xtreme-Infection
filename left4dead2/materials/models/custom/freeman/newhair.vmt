patch
{

include "materials/models/survivors/survivors_it_shared.vmt"
insert
{
$baseTexture "models\custom\freeman/hair"
$bumpmap "models\custom\freeman\gordon_beard_test_normal"

$halflambert 1
$translucent 1


$phong 1
$phongboost "1.4"
$phongexponent 7
$phongtint "[.85 .85 1]"
$phongfresnelranges "[.2 .5 5]"
$nodecal 1
$ambientocclusion 1
$halflambert 0
$diffuseexp "1.5"

$nodecal 1

}
}
patch
{

include "materials/models/survivors/survivors_it_shared.vmt"
insert
{
$baseTexture "models\custom\freeman\gordon_face_color"
$compress "models\custom\freeman\gordon_face_compress"

$nodecal 1

$bumpmap "models\custom\freeman\head_normal"
$phong 1
$phongboost "1.4"
$phongexponent 7
$phongtint "[.85 .85 1]"
$phongfresnelranges "[.2 .5 5]"
$nodecal 1
$ambientocclusion 1
$halflambert 0
$diffuseexp "1.5"
$lightwarptexture "models\survivors\gambler\gambler_head_wrp"
}
}

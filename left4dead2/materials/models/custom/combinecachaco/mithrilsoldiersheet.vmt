"VertexLitGeneric"
{
	"$baseTexture" 	"Models/custom/combinecachaco/Mithrilsoldiersheet"
    "$bumpmap"    	"Models/custom/combinecachaco/Mithrilsoldiersheet_normal"
	"$nodecal" "1"
	
	"$envmap" "env_cubemap"	
	"$envmapcontrast" "0.3"
	"$envmapsaturation" "0.5"
	"$envmaptint" "[.5 .5 .5]"
	"$normalmapalphaenvmapmask" "1"
	
	"$surfaceprop" "flesh"
	"$selfillum" "1"
	"$model" "1"
	
		$detail "models\survivors\survivor_it.vtf"
	$detailscale 3
	$detailblendfactor ".001" 
	$detailblendmode 0
	$ITAmount 0

	"proxies"
	{
		IT
		{
			resultVar $ITAmount
		}
		Equals
		{
			srcVar1 $ITAmount
			resultVar $detailblendfactor
		}
	}
}




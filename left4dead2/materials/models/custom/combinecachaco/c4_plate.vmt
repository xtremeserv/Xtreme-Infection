VertexLitGeneric
{
	"$basetexture"	"models/custom/combinecachaco\c4_plate"
	"$nodecal" "1"
	
	"$envmap" "env_cubemap"
	"$envmapmask" "models/custom/combinecachaco\c4_plate_spec"
	
	"$nocull" "1"
	
		$detail "models\survivors\survivor_it.vtf"
	$detailscale 3
	$detailblendfactor ".001" 
	$detailblendmode 0
	$ITAmount 0

	"proxies"
	{
		IT
		{
			resultVar $ITAmount
		}
		Equals
		{
			srcVar1 $ITAmount
			resultVar $detailblendfactor
		}
	}
}


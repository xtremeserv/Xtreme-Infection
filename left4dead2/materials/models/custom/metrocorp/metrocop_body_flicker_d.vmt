"VertexlitGeneric"
{
	"$basetexture" "models\custom\metrocorp\metro_body_color"
	"$bumpmap" "models\custom\metrocorp\metro_body_normal"

	"$phongexponenttexture" "models\custom\metrocorp\metro_body_exponent"

	"$color2"	"[0 0 0]"
	"$blendTintByBaseAlpha"	"1"

	"$phong" "1"
	"$phongboost"	"9.9934895"

	"$phongfresnelranges"	"[0.05 0.115 0.945]"

	"$phongdisablehalflambert"	"1"

	"$emissiveBlendEnabled" "1"
	"$emissiveBlendTexture"	"dev/null"
	"$emissiveBlendBaseTexture"	"models\custom\metrocorp\metro_body_emissive"
	"$emissiveBlendFlowTexture"	"dev/null"
//	"$emissiveBlendTint" "[2.52 0.64 0.036]"
	"$emissiveBlendStrength" "1"
	"$emissiveBlendScrollVector" "[0 0]"

	"$envmap" "models\cubemaps\fallout4cube_dithered_grey"
	"$normalmapalphaenvmapmask"		"1"
	"$envmapfresnel"	"1"

	"$envmaptint"		"[.2 .2 .2]"

    "Proxies"
    {
        "UniformNoise"
        {
            "resultVar" "$emissiveBlendTint"
            "minval" "0.5"
            "maxval" "1.00"
        }
    }
}
patch
{

include "materials/models/survivors/survivors_it_shared.vmt"
insert
{
"$BaseTexture" 	"models/custom/csf/ctm_heavy_helmet_head_color"
	"$BumpMap" 		"models/custom/csf/ctm_heavy_helmet_head_normal"

	$envmap                     "env_cubemap"	
	$envmaptint                 "[0.03 0.03 0.03]"
	$envmapfresnel              1


$phong 1
$phongboost 1
$phongtint                  "[0.8 0.8 1]"
$phongfresnelranges         "[1 3 6]"
$ambientocclusion 1
$normalmapalphaphongmask    1
$normalmapalphaenvmapmask   1

$nocull 1
$halflambert 1
}
}
